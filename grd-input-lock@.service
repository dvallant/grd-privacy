[Unit]
Description=Local input lock for GNOME Remote Desktop (watcher PID %i)

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/grd-privacy.py --lock-only --watch-pid %i

# Dedicated, short-lived user that may only open input devices
DynamicUser=yes
SupplementaryGroups=input
DevicePolicy=closed
DeviceAllow=char-input rw

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
